# migracionconayuda.com · web estática (sin WordPress)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS y sin www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://migracionconayuda.com/$1 [R=301,L]

  # Bloquear cualquier PHP salvo el formulario
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/enviar\.php$ [NC]
  RewriteRule ^ - [F,L]

  # Bloquear archivos ocultos (salvo .well-known para SSL)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Direcciones antiguas de WordPress -> páginas nuevas
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^(asesoria-legal|formacion-profesional|acompanamiento-inmobiliario|coaching-migratorio|productos-financieros|estudiar-futbol-en-espana|contacto)/?$ /$1.html [R=301,L]
  RewriteRule ^acompa%C3%B1amiento-inmobiliario/?$ /acompanamiento-inmobiliario.html [R=301,L,NE]
  RewriteRule ^en/?$ /en/index.html [L]
  RewriteRule ^en/home/?$ /en/ [R=301,L]
  RewriteRule ^en/asesoria-legal/?$ /en/legal-advice.html [R=301,L]
  RewriteRule ^en/formacion-profesional/?$ /en/professional-training.html [R=301,L]
  RewriteRule ^en/acompanamiento-inmobiliario/?$ /en/housing-support.html [R=301,L]
  RewriteRule ^en/coaching-migratorio/?$ /en/migration-coaching.html [R=301,L]
  RewriteRule ^en/productos-financieros/?$ /en/financial-products.html [R=301,L]
  RewriteRule ^en/estudiar-futbol-en-espana/?$ /en/study-football-in-spain.html [R=301,L]
  RewriteRule ^en/contacto/?$ /en/contact.html [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php)(/.*)?$ / [R=301,L]

  # URLs limpias: /asesoria-legal sirve asesoria-legal.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /index.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
